def require_desktop_validation(report, dist):
    if (report.get('status') != 'passed' or report.get('mode') != 'frozen'
            or report.get('platform') != 'win32' or report.get('build') != BUILD_ID
            or not REQUIRED_CHECKS.issubset(report.get('checks', []))):
        raise RuntimeError('Captura real e painel dos executáveis Windows ainda não foram validados.')
    expected = {name: fingerprint(Path(dist)/name) for name in ('VisualPilot_Central', 'VisualPilot_Coletor')}
