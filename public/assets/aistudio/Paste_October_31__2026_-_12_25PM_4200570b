        # Provenance identifies pixels actually decoded by the Central. JPEG
        # changes pixels; its hash cannot be compared to the pre-encoding image.
        packet = encode_frame('soak','session','fixture',1,image,**encoding)
        header_size = struct.unpack('!I',packet[4:8])[0]
