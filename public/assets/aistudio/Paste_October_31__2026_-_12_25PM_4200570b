"""Repeatable real-session benchmark; failed recognition exits nonzero.

Usage: python tools/check_colored_deck.py SESSION_DIRECTORY --output result.json
Real source frames remain local. Variants are robustness probes, not new hands.
"""
import argparse
import atexit
from datetime import datetime, timezone
import os
import uuid
import hashlib
import json
from pathlib import Path
import sys

import cv2
import numpy as np

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from visualpilot.pppoker.card_reader import CardRegionReader
from visualpilot.pppoker.replay.reader import ReplayReader
from visualpilot.pppoker.observer.perception import CachedReader
from visualpilot.pppoker.roi_engine import REGIONS, scaled_box


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('session', type=Path)
    parser.add_argument('--stress', action='store_true', help='Additional derived probes; not independent hands')
    parser.add_argument('--candidate', action='store_true', help='Opt-in reader and expanded flop crop')
    parser.add_argument('--output', type=Path, required=True)
    args = parser.parse_args()
    run_id = uuid.uuid4().hex
    started = datetime.now(timezone.utc).isoformat()
    status_path = args.output.with_suffix('.status.json')
    finished = False
    def status(state, **details):
        status_path.parent.mkdir(parents=True, exist_ok=True)
        data = dict(run_id=run_id, pid=os.getpid(), state=state, started_at=started,
                    updated_at=datetime.now(timezone.utc).isoformat(),
                    scope='colored-deck benchmark only', **details)
        temporary = status_path.with_name(status_path.name + '.' + run_id + '.tmp')
        temporary.write_text(json.dumps(data, indent=2), encoding='utf-8')
        temporary.replace(status_path)
    def on_exit():
        if not finished:
            status('interrupted_or_error')
    atexit.register(on_exit)
    status('running', completed_cases=0)
    reader = CardRegionReader(CachedReader(ReplayReader()), colored_deck=args.candidate)
    results = []
    labels = {'000001.png': {'hero_cards': ['Th', '6c'], 'board_flop': ['2c', '4h', '9c']},
              '000002.png': {'hero_cards': [], 'board_flop': []},
              '000003.png': {'hero_cards': [], 'board_flop': []}}
    expected_hashes = {'000001.png': 'eafba8a4eeff58f23f0541bd2be3d073f9d04df827e0b130af1c8190114ffaa0', '000002.png': '60676b8202ed335417cecc8b24cbd34e1059c04b7e35cb21d3eda812cbc15de3', '000003.png': 'a8bdbeb560d948228e8ea0bb5e79ee444542d52c27cfcb6a657fe6bda4a8d4a0'}
    for name, regions in labels.items():
        path = args.session / 'acompanhamento' / 'evidencias' / name
        source = cv2.imread(str(path))
        if source is None:
            raise ValueError(f'Missing or unreadable source: {path}')
        source = cv2.cvtColor(source, cv2.COLOR_BGR2RGB)
        digest = hashlib.sha256(path.read_bytes()).hexdigest()
        if digest != expected_hashes[name]:
            raise ValueError(f'Unlabeled source differs from approved fixture: {name}')
        variants = {'original': source,
                    'brightness_70_percent': (source.astype(float) * .7).astype(np.uint8),
                    'resize_75_percent': cv2.resize(source, None, fx=.75, fy=.75)}
        if args.stress:
            for level in (.45, .90, 1.15):
                variants[f'brightness_{level}'] = np.clip(source.astype(float)*level, 0, 255).astype(np.uint8)
            for scale in (.60, 1.25):
                variants[f'resize_{scale}'] = cv2.resize(source, None, fx=scale, fy=scale)
            for quality in (50, 80):
                ok, data = cv2.imencode('.jpg', source[:, :, ::-1], [cv2.IMWRITE_JPEG_QUALITY, quality])
                if not ok:
                    raise RuntimeError('JPEG encoding failed')
                variants[f'jpeg_{quality}'] = cv2.cvtColor(cv2.imdecode(data, cv2.IMREAD_COLOR), cv2.COLOR_BGR2RGB)
        for variant, image in variants.items():
            for region, expected in regions.items():
                y1, x1, y2, x2 = scaled_box((520, 130, 735, 475) if args.candidate and region == "board_flop" else REGIONS[region][0], image.shape[1], image.shape[0])
                result = reader.read_region(region, image[y1:y2, x1:x2])
                actual = [item['card'] for item in result['cards']]
                passed = actual == expected and result['status'] == ('SUCCESS' if expected else 'PENDING')
                results.append(dict(source=name, sha256=digest, variant=variant,
                                    region=region, expected=expected, actual=actual,
                                    passed=passed, reading=result))
                status('running', completed_cases=len(results), last_source=name,
                       last_variant=variant, last_region=region)
    report = dict(run_id=run_id, started_at=started, completed_at=datetime.now(timezone.utc).isoformat(), candidate=args.candidate, scope='Three real frames; derived variants are not independent hands. Not 52-card validation.',
                  labeling='Manual visual labels from uploaded session; empty frames are add-on breaks.',
                  passed=sum(row['passed'] for row in results), total=len(results), cases=results)
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(report, indent=2, ensure_ascii=False), encoding='utf-8')
    status('completed', completed_cases=len(results), passed=report['passed'],
           outcome='passed' if report['passed'] == len(results) else 'failed')
    finished = True
    print(f"{report['passed']}/{report['total']} cases passed; {args.output}")
    return 0 if all(row['passed'] for row in results) else 1


if __name__ == '__main__':
    raise SystemExit(main())


