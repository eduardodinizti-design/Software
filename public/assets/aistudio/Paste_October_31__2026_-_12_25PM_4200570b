        result=self.solve({KK:1,JJ:1},model)
        decision=next(d for d in result['decisions'] if d['history']==['bet:2','raise:6'])
        self.assertEqual(decision['chosen'],'fold')
        self.assertEqual(decision['alternatives'],{'fold':-2,'call':-6})
