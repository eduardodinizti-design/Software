                     rmse=[math.sqrt(sum((r['comparisons'][a]-v)**2 for a,v in exact.items())/len(exact))
                           if r['status']=='experimental' else None for r in sampled],
                     seconds=reference['seconds']+sum(r['seconds'] for r in sampled))
