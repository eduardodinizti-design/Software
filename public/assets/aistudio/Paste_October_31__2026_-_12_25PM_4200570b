class ImmediateExecutor:
    def __init__(self, **kwargs): pass
    def submit(self, function, *args):
        future = Future()
        try: future.set_result(function(*args))
        except Exception as exc: future.set_exception(exc)
        return future
    def shutdown(self, **kwargs): pass


