"""Run one Python build stage, preserving its log and exact failure exit code.

Uses only the standard library so installation failures are recorded too.
PYTHONIOENCODING controls child console output, not default file encodings.
"""
import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time


def run_stage(name, arguments, output):
    if not re.fullmatch(r'[a-z0-9][a-z0-9_-]*',name):
        raise ValueError('Invalid stage name')
    output.mkdir(parents=True,exist_ok=True)
    report_path=output/f'{name}.json'
    command=[sys.executable,*arguments]
    report=dict(stage=name,state='running',started_at=datetime.now(timezone.utc).isoformat(),
                platform=sys.platform,python=sys.version,commit=os.environ.get('GITHUB_SHA'),
                command=command,log=f'{name}.log')
    def save():
        temporary=report_path.with_suffix('.tmp')
        temporary.write_text(json.dumps(report,indent=2,ensure_ascii=False),encoding='utf-8')
        temporary.replace(report_path)
    save();start=time.monotonic();process=None
    environment=dict(os.environ,PYTHONIOENCODING='utf-8:backslashreplace',PYTHONUNBUFFERED='1')
    # Logging native stderr through PowerShell's pipeline can itself produce
    # NativeCommandError. Capture both streams here and relay as stdout instead.
    with (output/f'{name}.log').open('w',encoding='utf-8') as log:
        def relay(line):
            log.write(line);log.flush()
            print(line,end='',flush=True)
        try:
            relay(f'=== Stage: {name} ===\n')
            process=subprocess.Popen(command,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,
                                     text=True,encoding='utf-8',errors='replace',env=environment)
            for line in process.stdout:relay(line)
            code=process.wait()
            report.update(state='passed' if code==0 else 'failed',exit_code=code)
        except BaseException as exc:
            if process is not None and process.poll() is None:
                process.terminate()
