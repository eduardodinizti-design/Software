def fingerprint(folder):
    """Bind evidence to the executable AND its packaged libraries/assets."""
    folder = Path(folder)
    executable = folder/folder.name
    if sys.platform == 'win32':
        executable = executable.with_suffix('.exe')
    files = [executable, *sorted(p for p in (folder/'_internal').rglob('*') if p.is_file())]
    if not executable.is_file() or len(files) < 2:
        raise ValueError(f'Pacote incompleto: {folder}')
    digest = hashlib.sha256()
    for path in files:
        digest.update(str(path.relative_to(folder)).replace('\\', '/').encode())
        digest.update(b'\0')
        digest.update(hashlib.sha256(path.read_bytes()).digest())
    return dict(sha256=digest.hexdigest(), files=len(files))


