"""Exercise fictitious registration through PNG screenshots, OCR and a browser GUI."""
import argparse
from dataclasses import replace
import json
from pathlib import Path
import sys
from time import monotonic

from playwright.sync_api import sync_playwright

from visualpilot.lab.registration import RegistrationLedger, RegistrationRules, adjust_and_register
from visualpilot.lab.registration_gui import RegistrationGUI
from visualpilot.pppoker.replay.reader import ReplayReader


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--output', default='diagnostics/registration/browser')
    parser.add_argument('--chromium', default='/usr/bin/chromium')
    args = parser.parse_args()
    output = Path(args.output)
    output.mkdir(parents=True, exist_ok=True)
    if any(output.iterdir()):
        parser.error('Use uma pasta vazia para preservar evidências anteriores.')
    report = dict(status='failed', platform=sys.platform,
                  scope='isolated_browser_png_template_coordinates_real_ocr_simulated_registration',
                  checks=[], browser_errors=[], known_gaps=[])
    rules = RegistrationRules(('T1', 'T2', 'T3', 'T4'))
    reader = ReplayReader()
    started = monotonic()

    def offer(amount=50, tournament='T1', offer_id='P1'):
        return dict(tournament=tournament, offer=offer_id, kind='MTT', bounty=False,
                    amount=amount, stack=10000, minimum=10, maximum=100, step=5)

    try:
        with sync_playwright() as playwright:
            browser = playwright.chromium.launch(executable_path=args.chromium, headless=True, args=['--no-sandbox'])

            def case(name, initial, expected, configure=lambda gui: None, *, viewport=None, dpr=1):
                folder = output/name
                page = browser.new_page(viewport=viewport or {'width':1000, 'height':1000}, device_scale_factor=dpr)
                page.on('pageerror', lambda error: report['browser_errors'].append(str(error)))
                gui = RegistrationGUI(page, reader, folder)
                page.evaluate('offer=>resetLab(offer)', initial)
                configure(gui)
                ledger = RegistrationLedger(folder/'ledger.sqlite')
                try:
                    result = adjust_and_register(gui, ledger, rules, 50, gui.control)
                    actions = page.evaluate('lab.actions')
                    clicks_path = folder/'clicks.jsonl'
                    clicks = [json.loads(line) for line in clicks_path.read_text().splitlines()] if clicks_path.exists() else []
                    row = dict(name=name, result=result, actions=actions, visual_clicks=clicks)
                    report['checks'].append(row)
                    page.screenshot(path=str(folder/'final.png'), full_page=True)
                    assert result['status'] in (expected if isinstance(expected, tuple) else (expected,)), row
                    return result, actions
                finally:
                    ledger.close()
                    page.close()

            result, actions = case('increase-10-to-50', offer(10), 'confirmed')
            assert [a['action'] for a in actions] == ['increase']*8+['register']
            result, actions = case('decrease-60-to-50', offer(60), 'confirmed')
            assert [a['action'] for a in actions] == ['decrease']*2+['register']
            result, actions = case('stuck-selector', offer(40), 'blocked', lambda gui: gui.page.evaluate('lab.stuck=true'))
            assert len(actions) == 1 and actions[0]['action'] == 'increase'
            result, actions = case('malformed-cost', offer(), 'blocked', lambda gui: gui.page.evaluate('''()=>{
                [...document.querySelectorAll('#popup p')].find(p=>p.textContent.startsWith('Custo:')).textContent='Custo: 50/100 fichas ficticias';
            }'''))
            assert not actions

            def pause_after_ocr(gui):
                original = gui.capture
                def capture():
                    sample = original()
                    gui.page.get_by_role('button', name='Assumir manual', exact=True).click()
                    gui.control.set_mode('manual')
                    return sample
                gui.capture = capture
            result, actions = case('manual-during-ocr', offer(), 'blocked', pause_after_ocr)
            assert not actions

            def replace_after_ocr(gui):
                original = gui.capture
                def capture():
                    sample = original()
                    gui.page.evaluate('offer=>resetLab(offer)', offer(50, 'T2', 'P2'))
                    return sample
                gui.capture = capture
            result, actions = case('popup-replaced-before-click', offer(40), 'blocked', replace_after_ocr)
            assert not actions
            result, actions = case('explicit-rejection', offer(), 'rejected', lambda gui: gui.page.evaluate('lab.reject=true'))
            assert len(actions) == 1

            def move_popup(gui):
                gui.page.evaluate("document.querySelector('#popup').style.transform='translate(120px, 65px)'")
            result, actions = case('moved-popup', offer(45), 'confirmed', move_popup,
                                   viewport={'width':1300, 'height':1200})
            assert [a['action'] for a in actions] == ['increase', 'register']

            def crop(gui):
                # Oracle used only to choose a nonzero test ROI, never to locate a click.
                box = gui.page.locator('#popup').bounding_box()
                gui.capture_region = (int(box['x'])-5, int(box['y'])-5, int(box['width'])+10, int(box['height'])+10)
            result, actions = case('cropped-image-origin', offer(55), 'confirmed', crop)
            assert [a['action'] for a in actions] == ['decrease', 'register']
            result, actions = case('high-dpi-browser', offer(45), ('confirmed', 'blocked'), dpr=2)
            if result['status'] == 'confirmed':
                assert [a['action'] for a in actions] == ['increase', 'register']
            else:
                assert not any(a['action'] == 'register' for a in actions)
                report['known_gaps'].append(dict(scenario='high-dpi-browser', result=result,
                    limitation='Native high-DPI raster needs independently validated templates/OCR; blocked, not certified.'))

            def scaled(gui):
                gui.page.evaluate("document.querySelector('#popup').style.cssText='transform:scale(1.25);transform-origin:top left'")
            result, actions = case('scaled-popup-125', offer(45), ('confirmed', 'blocked'), scaled,
                                   viewport={'width':1400, 'height':1400})
            if result['status'] == 'confirmed':
                assert [a['action'] for a in actions] == ['increase', 'register']
            else:
                assert not any(a['action'] == 'register' for a in actions)
                report['known_gaps'].append(dict(scenario='scaled-popup-125', result=result,
                    limitation='125% popup did not meet visual acceptance; blocked, not certified.'))

            def duplicate(gui):
                gui.page.evaluate("document.querySelector('#popup').append(document.querySelector('#register').cloneNode(true))")
            result, actions = case('two-register-buttons', offer(45), 'blocked', duplicate)
            assert not actions
            result, actions = case('register-not-visible', offer(45), 'blocked',
                lambda gui: gui.page.evaluate("document.querySelector('#register').remove()"))
            assert not actions
            result, actions = case('text-without-button', offer(45), 'blocked',
                lambda gui: gui.page.evaluate("document.querySelector('#register').outerHTML='<p>Registrar</p>'"))
            assert not actions

            def move_after_ocr(gui):
                original = gui.capture
                def capture():
                    sample = original()
                    move_popup(gui)  # Deliberately no semantic revision change.
                    return sample
                gui.capture = capture
            result, actions = case('moved-after-observation', offer(45), 'blocked', move_after_ocr)
            assert not actions

            def close_without_receipt(gui):
                original = gui.apply
                def apply(action, revision, token):
                    applied = original(action, revision, token)
                    if applied and action == 'register':
                        gui.page.evaluate("document.querySelector('#popup').replaceChildren()")
                    return applied
                gui.apply = apply
            result, actions = case('closed-without-receipt', offer(), 'unknown', close_without_receipt)
            assert [a['action'] for a in actions] == ['register']

            def try_repeated_click(gui):
                original = gui.apply
                def apply(action, revision, token):
                    applied = original(action, revision, token)
                    if applied:
                        assert original(action, revision, token) is False
                    return applied
                gui.apply = apply
            result, actions = case('coordinates-consumed-once', offer(45), 'confirmed', try_repeated_click)
            assert [a['action'] for a in actions] == ['increase', 'register']

            folder = output/'four-slots'
            page = browser.new_page(viewport={'width':1000, 'height':1000})
            gui = RegistrationGUI(page, reader, folder)
            ledger = RegistrationLedger(folder/'ledger.sqlite')
            try:
                for tournament in rules.targets:
                    page.evaluate('offer=>resetLab(offer)', offer(50, tournament))
                    result = adjust_and_register(gui, ledger, rules, 50, gui.control)
                    assert result['status'] == 'confirmed', result
                page.evaluate('offer=>resetLab(offer)', offer(50, 'T5'))
                result = adjust_and_register(gui, ledger, replace(rules, targets=('T5',)), 50, gui.control)
                assert result.get('reason') == 'simultaneous_limit', result
                assert not page.evaluate('lab.actions')
                report['checks'].append(dict(name='four-slots-fifth-blocked', result=result))
                page.screenshot(path=str(folder/'fifth-blocked.png'), full_page=True)
            finally:
                ledger.close()
                page.close()
            browser.close()
        assert not report['browser_errors'], report['browser_errors']
        report['status'] = 'passed_with_limits' if report['known_gaps'] else 'passed'
    finally:
        report['elapsed_seconds'] = round(monotonic()-started, 3)
        (output/'report.json').write_text(json.dumps(report, ensure_ascii=False, indent=2))
        print(json.dumps(report, ensure_ascii=False, indent=2))


if __name__ == '__main__':
    main()


