"""Inspect an original PNG using manually annotated v228 reference regions.

No capture, click, registration, scaling or desktop-coordinate inference occurs.
"""
import argparse
import hashlib
import json
from pathlib import Path

import numpy as np
from PIL import Image

from visualpilot.lab.pppoker_lobby_reference import annotated_crops, lobby_card, recognize_reference_field
from visualpilot.pppoker.replay.reader import ReplayReader


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('png', type=Path)
    parser.add_argument('--view', choices=['lobby', 'details', 'modal'], required=True)
    parser.add_argument('--profile', type=Path, default=Path(__file__).resolve().parents[1]/'docs/lab-lobby-real/reference.json')
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--ocr-mode', choices=['direct', 'paired'], default='direct')
    args = parser.parse_args()
    profile = json.loads(args.profile.read_text())
    with Image.open(args.png) as image:
        if image.format != 'PNG':
            parser.error('Use o PNG original, sem conversão de JPEG.')
        if list(image.size) != profile['views'][args.view]['size']:
            parser.error('Dimensões diferentes da referência. Recalibre; não redimensione.')
        rgb = np.asarray(image.convert('RGB'))
    crops = annotated_crops(rgb, profile['views'][args.view])
    args.output.mkdir(parents=True, exist_ok=True)
    if any(args.output.iterdir()):
        parser.error('Use uma pasta vazia para preservar os resultados anteriores.')
    reader = ReplayReader()
    report = dict(status='inspection_only', view=args.view, ocr_mode=args.ocr_mode, coordinate_space=profile['coordinate_space'],
                  source_sha256=hashlib.sha256(args.png.read_bytes()).hexdigest(),
                  profile_sha256=hashlib.sha256(args.profile.read_bytes()).hexdigest(),
                  clicks_executed=0, registration_authorized=False, items=[])
    Image.fromarray(rgb).save(args.output/'source.png')
    for crop in crops:
        rows, evidence = {}, {}
        for name, pixels in crop['fields'].items():
            Image.fromarray(pixels).save(args.output/f"{crop['id']}-{name}.png")
            if args.ocr_mode == 'paired':
                rows[name], evidence[name] = recognize_reference_field(reader, pixels, name)
            else:
                text, confidence = reader.field(pixels)
                rows[name] = [([], text, confidence)]
        record = dict(id=crop['id'], complete=crop['complete'], fields=rows,
                      image_point=crop['image_point'], ocr_evidence=evidence)
        if args.view == 'lobby':
            record['reading'] = lobby_card(rows, complete=crop['complete'])
        report['items'].append(record)
    # Details/modal are not compared with an invented prior live observation.
    (args.output/'report.json').write_text(json.dumps(report, ensure_ascii=False, indent=2, default=float)+'\n')
    print(args.output/'report.json')


if __name__ == '__main__':
    main()


