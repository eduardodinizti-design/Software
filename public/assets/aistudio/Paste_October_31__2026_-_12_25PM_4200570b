"""Exercise the collector executable against the real v2 receiver on loopback.

The receiver runs from the checked-out source. This verifies the frozen collector
entry point and transport, not desktop capture, OCR, or two physical computers.
"""
import argparse
import asyncio
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
from time import monotonic
from types import SimpleNamespace
import uuid

ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT))

import numpy as np
from visualpilot.pppoker.observer.freshness import MAX_SOURCE_AGE,frame_sha256
from visualpilot.pppoker.observer.runtime import Mailbox
from visualpilot.pppoker.stream_receiver import StreamReceiver
from visualpilot.pppoker.transport_freshness import VERSION
from tools.validate_distribution import stop_process_tree


async def validate(command,output,*,expect_frozen,timeout=30.):
    output=Path(output).resolve()
    output.mkdir(parents=True,exist_ok=True)
    nonce=uuid.uuid4().hex
    child_report=output/'collector-probe.json'
    report=dict(status='failed',platform=sys.platform,mode='frozen' if expect_frozen else 'source',
                scope='collector_entry_and_loopback_transport',nonce=nonce,protocol=VERSION,
                source_age_limit_seconds=MAX_SOURCE_AGE,frames=[])
    frames=[]
    class Recorder(Mailbox):
        def put(self,item,rgb,stamp=None):
            super().put(item,rgb,stamp)
            sample=self.take()
            if sample is not None:
                metadata,pixels,source,_=sample
                frames.append(dict(sequence=metadata['sequence'],table=metadata['table_key'],
                    collector_session=metadata['collector_session'],transport=metadata['transport'],
                    source_observed=source,source_age_seconds=monotonic()-source,
                    frame_sha256=frame_sha256(pixels)))
    receiver=StreamReceiver(SimpleNamespace(frames=Recorder()),'127.0.0.1',0)
    process=None
    try:
        if expect_frozen:
            report['executable_sha256']=hashlib.sha256(Path(command[0]).read_bytes()).hexdigest()
        address=await receiver.start()
        arguments=[*map(str,command),'--lab-transport-probe','--port',str(address[1]),
                   '--nonce',nonce,'--report',str(child_report)]
        environment=dict(os.environ)
        environment.pop('PYTHONPATH',None)
        if not expect_frozen:environment['PYTHONPATH']=str(ROOT)
        with tempfile.TemporaryDirectory() as folder, (output/'collector-transport.log').open('wb') as log:
            try:
                process=subprocess.Popen(arguments,cwd=folder,stdin=subprocess.DEVNULL,
                                         stdout=log,stderr=log,env=environment)
                deadline=monotonic()+timeout
                while process.poll() is None and monotonic()<deadline:
                    await asyncio.sleep(.05)
                if process.poll() is None:raise TimeoutError('Collector did not complete its loopback probe')
                if process.returncode!=0:raise RuntimeError(f'Collector exited with code {process.returncode}; see collector-transport.log')
                child=json.loads(child_report.read_text(encoding='utf-8'))
                report['collector']=child
                if (child.get('nonce')!=nonce or child.get('status')!='passed'
                        or child.get('protocol')!=VERSION or child.get('acknowledged_frames')!=2
                        or child.get('frozen') is not expect_frozen):
                    raise ValueError('Collector report does not match this execution')
                if [frame['sequence'] for frame in frames]!=[1,2]:
                    raise ValueError('Receiver did not accept the two expected frame sequences')
                expected_table=json.dumps(['lab-'+nonce,child['collector_session'],'transport-probe'],separators=(',',':'))
                for frame in frames:
                    expected=frame_sha256(np.full((40,30,3),frame['sequence'],dtype=np.uint8))
                    proof=frame['transport']
                    if (frame['table']!=expected_table or frame['frame_sha256']!=expected
                            or frame['collector_session']!=child['collector_session']
                            or proof.get('verified') is not True or proof.get('protocol')!=VERSION
                            or frame['source_observed']!=proof['not_before_monotonic']
                            or not 0<=frame['source_age_seconds']<=MAX_SOURCE_AGE):
                        raise ValueError('Frame pixels, identity or freshness proof do not match')
                if expect_frozen and report['executable_sha256']!=hashlib.sha256(Path(command[0]).read_bytes()).hexdigest():
                    raise ValueError('Collector executable changed during validation')
                report['status']='passed'
            finally:
                if process is not None:stop_process_tree(process)
    except Exception as exc:
        report['error']=f'{type(exc).__name__}: {exc}'
    finally:
        await receiver.close()
        report.update(frames=frames,transport_metrics=receiver.metrics)
        (output/'collector-transport-validation.json').write_text(json.dumps(report,indent=2),encoding='utf-8')
    return report


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--source',action='store_true',help='Validate the source entry script instead of a frozen executable')
    parser.add_argument('--output',type=Path,default=ROOT/'diagnostics'/'collector')
    args=parser.parse_args()
    if args.source:
        command=[sys.executable,str(ROOT/'visualpilot/pppoker/stream_node.py')]
    else:
        if sys.platform!='win32':parser.error('Frozen distribution validation requires Windows')
        command=[str(ROOT/'dist/VisualPilot_Coletor/VisualPilot_Coletor.exe')]
    report=asyncio.run(validate(command,args.output,expect_frozen=not args.source))
    print(json.dumps(report))
    return 0 if report['status']=='passed' else 1


if __name__=='__main__':raise SystemExit(main())


