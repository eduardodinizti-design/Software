"""Export tracked project sources/evidence and an indexed single-file code reference.

Uses only the Python standard library. Does not import or launch application code.
"""
import argparse
import hashlib
import json
from pathlib import Path
import subprocess
import zipfile
from datetime import datetime, timezone


EXTRA = (
    'docs/ESTADO_ATUAL_EXPORTACAO.md',
    'docs/regras_planejadas.json',
    'docs/phase1/module1/user-repeat-review.json',
    'tools/export_project.py',
)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output-dir', type=Path, required=True)
    args = parser.parse_args()
    root = Path(__file__).resolve().parents[1]
    names = subprocess.check_output(['git', 'ls-files', '-z'], cwd=root).decode().split('\0')
    names = sorted(set(filter(None, names)) | set(EXTRA))
    out = args.output_dir.resolve()
    out.mkdir(parents=True, exist_ok=False)
    source = out / 'VisualPilot_Codigo_Consolidado.txt'
    archive = out / 'VisualPilot_Projeto_Completo.zip'
    manifest = {
        'created_at_utc': datetime.now(timezone.utc).isoformat(),
        'base_commit': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=root).decode().strip(),
        'snapshot': 'working_tree_tracked_files_plus_explicit_export_documents',
        'runtime_validation': 'not_performed_by_exporter',
        'files': [],
        'excluded_scope': ['git history', 'local credentials/configs', 'installed dependencies',
                           'untracked sessions/diagnostics', 'untracked distribution executables'],
    }
    with source.open('w', encoding='utf-8', newline='\n') as reference, zipfile.ZipFile(
        archive, 'x', compression=zipfile.ZIP_DEFLATED
    ) as z:
        reference.write('VISUALPILOT — EXPORTAÇÃO PARA CONSULTA; NÃO É UM SCRIPT EXECUTÁVEL\n\n')
        reference.write((root / EXTRA[0]).read_text(encoding='utf-8'))
        for name in names:
            path = root / name
            if path.is_symlink() or not path.is_file():
                raise ValueError(f'Arquivo ausente ou link não permitido: {name}')
            data = path.read_bytes()
            digest = hashlib.sha256(data).hexdigest()
            manifest['files'].append({'path': name, 'bytes': len(data), 'sha256': digest})
            z.writestr('VisualPilot/' + name, data)
            # Keep evidence in ZIP; readable code includes scripts/tests/config/builds.
            if name.split('/')[0] not in {'docs', 'tests'} or name.endswith('.py'):
                try:
                    content = data.decode('utf-8')
                except UnicodeDecodeError:
                    continue
                if '\0' not in content:
                    reference.write(f'\n\n{"=" * 80}\nARQUIVO: {name}\nSHA256: {digest}\n{"=" * 80}\n')
                    reference.write(content)
            elif name == 'docs/regras_planejadas.json':
                reference.write('\n\nREGRAS PLANEJADAS (NÃO CARREGADAS PELO RUNTIME)\n')
                reference.write(data.decode('utf-8'))
        serialized = json.dumps(manifest, indent=2, ensure_ascii=False) + '\n'
        z.writestr('VisualPilot/MANIFESTO.json', serialized)
    (out / 'MANIFESTO.json').write_text(serialized, encoding='utf-8')
    (out / 'LEIA_PRIMEIRO.md').write_text((root / EXTRA[0]).read_text(encoding='utf-8'), encoding='utf-8')
    with zipfile.ZipFile(archive) as z:
        assert z.testzip() is None
        for item in manifest['files']:
            data = z.read('VisualPilot/' + item['path'])
            assert len(data) == item['bytes']
            assert hashlib.sha256(data).hexdigest() == item['sha256']
    report = {'verified_files': len(manifest['files']), 'zip_crc_and_sha256': 'passed',
              'artifacts': {p.name: {'bytes': p.stat().st_size,
                            'sha256': hashlib.sha256(p.read_bytes()).hexdigest()}
                            for p in (source, archive)}}
    (out / 'VERIFICACAO.json').write_text(json.dumps(report, indent=2), encoding='utf-8')
    print(json.dumps(report, indent=2))


if __name__ == '__main__':
    main()


