"""Run freshness fault-injection tests with a durable progress/result record.

No background service or strategy actions are started. This command exits after
one round; `completed` is not approval of the whole operational stage.
"""
import argparse
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import sys
import unittest
import uuid

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output',type=Path,required=True)
    parser.add_argument('--include-transport',action='store_true')
    args=parser.parse_args()
    args.output.mkdir(parents=True,exist_ok=True)
    files=['tests/test_runtime_freshness.py','tests/observation_assertions.py','visualpilot/pppoker/observer/runtime.py',
           'visualpilot/pppoker/observer/freshness.py','visualpilot/pppoker/scheduler.py',
           'visualpilot/viz/session.py','visualpilot/viz/monitor.py',
           'visualpilot/agent/bridge.py','visualpilot/pppoker/stream_receiver.py']
    if args.include_transport:
        files += ['tests/test_transport_freshness.py','visualpilot/pppoker/transport_freshness.py',
                  'visualpilot/pppoker/stream_node.py','visualpilot/pppoker/multitable.py',
                  'visualpilot/viz/app.py','visualpilot/viz/launcher.py']
    files.append('tools/check_freshness_lab.py')
    state=dict(run_id=uuid.uuid4().hex,pid=os.getpid(),state='running',
               started_at=datetime.now(timezone.utc).isoformat(),tests=[],
               scope='controlled runtime faults'+(' and real loopback TCP transport' if args.include_transport else '')+'; physical Windows validation separate',
               platform=sys.platform,
               source_sha256={f:hashlib.sha256((ROOT/f).read_bytes()).hexdigest() for f in files})
    target=args.output/'status.json'
    temporary=args.output/(state['run_id']+'.tmp')
    def save():
        state['updated_at']=datetime.now(timezone.utc).isoformat()
        temporary.write_text(json.dumps(state,indent=2,ensure_ascii=False),encoding='utf-8')
        temporary.replace(target)
    class Result(unittest.TextTestResult):
        def startTest(self,test):
            super().startTest(test);state['current_test']=test.id();save()
        def addSuccess(self,test):
            super().addSuccess(test);state['tests'].append(dict(test=test.id(),outcome='passed'));save()
        def addFailure(self,test,error):
            super().addFailure(test,error);state['tests'].append(dict(test=test.id(),outcome='failed'));save()
        def addError(self,test,error):
            super().addError(test,error);state['tests'].append(dict(test=test.id(),outcome='error'));save()
        def addSubTest(self,test,subtest,error):
            super().addSubTest(test,subtest,error)
            if error is not None:
                state['tests'].append(dict(test=subtest.id(),outcome='failed'));save()
    save()
    try:
        suite=unittest.defaultTestLoader.discover(str(ROOT/'tests'),pattern='test_runtime_freshness.py')
        if args.include_transport:
            suite.addTests(unittest.defaultTestLoader.discover(str(ROOT/'tests'),pattern='test_transport_freshness.py'))
        with (args.output/'tests.log').open('w',encoding='utf-8') as log:
            result=unittest.TextTestRunner(stream=log,verbosity=2,resultclass=Result).run(suite)
        state.update(state='completed',current_test=None,tests_run=result.testsRun,
                     outcome='passed' if result.wasSuccessful() else 'failed',
                     failures=len(result.failures),errors=len(result.errors),stage_approved=False)
        save()
        print(f"Freshness lab: {result.testsRun} tests; {state['outcome']}; {target}")
        return 0 if result.wasSuccessful() else 1
    except BaseException:
        state.update(state='interrupted_or_error');save();raise


if __name__=='__main__':
    raise SystemExit(main())


