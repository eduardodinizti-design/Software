class ButtonLocatorTests(unittest.TestCase):
    def setUp(self):
        self.button = np.full((34, 128, 3), 230, np.uint8)
        cv2.rectangle(self.button, (0, 0), (127, 33), (80, 80, 80), 1)
        cv2.putText(self.button, 'Registrar', (7, 25), cv2.FONT_HERSHEY_SIMPLEX,
