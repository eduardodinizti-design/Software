"""Reproduce slow first OCR with real TCP/OCR and the integration trace assertions.

Runs the three tests reported failing in Windows with one six-second text delay
per test. Capture validity remains five seconds. This is fault injection on the
current platform, not an emulation of Windows or its hardware.
"""
import argparse
import json
from pathlib import Path
import sys
import threading
import unittest
from unittest.mock import patch

ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT))
sys.path.insert(0,str(ROOT/'tests'))


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--delay-seconds',type=float,default=6.)
    args=parser.parse_args()
    if not 5.<args.delay_seconds<=15.:
        parser.error('The injected delay must exceed five seconds and be at most fifteen seconds')
    from visualpilot.pppoker.replay.service import OCRService
    lock=threading.Lock()
    state=dict(test=None,injected=False)

    class SlowFirstText(OCRService):
        def call(self,kind,rgb,stop):
            with lock:
                inject=kind=='perception' and not state['injected']
                if inject:state['injected']=True
            if inject:
                print('INJECTED_TEXT_DELAY '+json.dumps(dict(test=state['test'],
                    seconds=args.delay_seconds,platform=sys.platform)),flush=True)
                if stop.wait(args.delay_seconds):raise InterruptedError('Stopped during injected delay')
            return super().call(kind,rgb,stop)

    class Result(unittest.TextTestResult):
        def startTest(self,test):
            with lock:state.update(test=test.id(),injected=False)
            super().startTest(test)
        def addSuccess(self,test):
            if not state['injected']:
                try:raise AssertionError('The test never reached the delayed text call')
                except AssertionError:self.addFailure(test,sys.exc_info())
            else:super().addSuccess(test)

    names=[
        'test_remote_recovery.RemoteRecoveryTests.test_disconnect_expiry_reconnect_new_hand_three_cycles',
        'test_remote_recovery.RemoteRecoveryTests.test_new_collector_sessions_replace_old_tables_three_cycles',
        'test_single_table_pipeline.SingleTablePipelineTests.test_tcp_real_ocr_hand_change_and_journal',
    ]
    suite=unittest.defaultTestLoader.loadTestsFromNames(names)
    with patch('visualpilot.pppoker.observer.runtime.OCRService',SlowFirstText):
        result=unittest.TextTestRunner(verbosity=2,resultclass=Result).run(suite)
    return 0 if result.wasSuccessful() else 1


if __name__=='__main__':raise SystemExit(main())


