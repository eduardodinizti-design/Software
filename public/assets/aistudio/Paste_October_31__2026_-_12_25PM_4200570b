"""PNG versus JPEG: normal packet/receiver, real OCR, labeled recorded fixtures.

This is an in-process codec experiment, not a network/Windows capacity test.
Derived scales and masks are not independent real hands. Exit nonzero when a
JPEG candidate loses a PNG-readable labeled card region or changes text fields.
"""
import argparse
import hashlib
import json
from pathlib import Path
import platform
import sys
from time import perf_counter
from types import SimpleNamespace

ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT))
import cv2
import numpy as np
from visualpilot.pppoker.card_reader import CardRegionReader
from visualpilot.pppoker.discovery import detect_tables
from visualpilot.pppoker.observer.perception import CachedReader, read_table
from visualpilot.pppoker.observer.runtime import Mailbox
from visualpilot.pppoker.replay.reader import ReplayReader
from visualpilot.pppoker.roi_engine import REGIONS, scaled_box
from visualpilot.pppoker.stream_node import encode_frame, prepare_capture
from visualpilot.pppoker.stream_receiver import StreamReceiver
from visualpilot.pppoker.transport_freshness import CaptureTicket


def fixtures():
    base=ROOT/'tests/fixtures'
    def load(path):
        return cv2.cvtColor(cv2.imread(str(path)),cv2.COLOR_BGR2RGB)
    for name,hero,board in [('left_99',['Th','4d'],['7h','As','Ts']),('right_99',['5c','2s'],[])]:
        path=base/'actions'/f'{name}.png'
        image=load(path)
        provenance=dict(path=str(path.relative_to(ROOT)),sha256=hashlib.sha256(path.read_bytes()).hexdigest())
        for scale in (1.,1.25,1.5):
            yield f'{name}-scale-{scale}',cv2.resize(image,None,fx=scale,fy=scale,interpolation=cv2.INTER_CUBIC),hero,board,provenance
        masked=image.copy()
        y,x,yy,xx=REGIONS['hero_cards'][0]
        masked[y:yy,x:xx]=(40,70,120)
        yield name+'-masked-hero',masked,[],board,provenance
        desktop=np.full((1700,2200,3),32,np.uint8)
        desktop[20:20+image.shape[0],20:20+image.shape[1]]=image
        x,y,w,h=detect_tables(desktop)[0]['box']
        yield name+'-discovery-crop',desktop[y:y+h,x:x+w],hero,board,provenance
    labels=json.loads((base/'heldout_cards/labels.json').read_text())['cases']
    for path in sorted((base/'heldout_cards').glob('*.png')):
        label=labels[path.stem]
        yield path.stem,load(path),label['hero'],label['board'],dict(
            path=str(path.relative_to(ROOT)),sha256=hashlib.sha256(path.read_bytes()).hexdigest())


def inspect_image(engine,image,hero,board):
    # The receiver's Mailbox already applies the normal runtime size limit.
    reader=CachedReader(engine)
    cards=CardRegionReader(reader)
    checks={}
    expected={'hero_cards':hero,'board_flop':board[:3],
              'board_turn':board[3:4],'board_river':board[4:5]}
    for region,values in expected.items():
        y,x,yy,xx=scaled_box(REGIONS[region][0],image.shape[1],image.shape[0])
        result=cards.read_region(region,image[y:yy,x:xx])
        actual=[v['card'] for v in result['cards']]
        checks[region]=dict(expected=values,actual=actual,passed=actual==values)
    reading=read_table(reader,image)
    checks['full_hero']=dict(expected=hero,actual=reading.get('hero'),passed=reading.get('hero')==hero)
    checks['full_board']=dict(expected=board,actual=reading.get('board'),passed=reading.get('board')==board)
    # Comparing text to PNG detects changes, not independent truth of those fields.
    text={k:reading.get(k) for k in ('hand_id','pot','hero_stack','actions','street')}
    text['hero_buttons']=[{k:v for k,v in button.items() if k not in ('confidence','box')}
                          for button in reading.get('hero_buttons',[])]
    return checks,text


def run(output,repeats):
    output.parent.mkdir(parents=True,exist_ok=True)
    report=dict(status='running',scope=__doc__,python=platform.python_version(),opencv=cv2.__version__,
                jpeg_sampling='4:4:4',cases=[],summary={})
    def save():
        temporary=output.with_suffix('.tmp')
        temporary.write_text(json.dumps(report,ensure_ascii=False,indent=2),encoding='utf-8')
        temporary.replace(output)
    save()
    engine=ReplayReader()
    # Warm up outside timing; candidate order rotates to reduce first-use bias.
    engine.field(np.full((60,80,3),255,np.uint8))
    modes=[('png',95),('jpeg',85),('jpeg',95),('jpeg',100)]
    for index,(name,source,hero,board,provenance) in enumerate(fixtures()):
        image=prepare_capture(source)
        for codec,quality in modes[index%len(modes):]+modes[:index%len(modes)]:
            label='png' if codec=='png' else f'jpeg-{quality}'
            enc=[];dec=[]
            for _ in range(repeats):
                ticket=CaptureTicket()
                t=perf_counter()
                packet=encode_frame('codec-lab','session','table',1,image,
                    capture_ticket=ticket.token,image_codec=codec,jpeg_quality=quality)
                enc.append((perf_counter()-t)*1000)
                runtime=SimpleNamespace(frames=Mailbox())
                receiver=StreamReceiver(runtime)
                t=perf_counter()
                assert receiver.accept_packet(packet[4:],ticket)
                dec.append((perf_counter()-t)*1000)
                decoded=runtime.frames.take()[1]
            t=perf_counter()
            checks,text=inspect_image(engine,decoded,hero,board)
            row=dict(case=name,codec=label,source=provenance,packet_bytes=len(packet),
                     encode_ms=float(np.median(enc)),receive_ms=float(np.median(dec)),
                     ocr_seconds=perf_counter()-t,checks=checks,text=text,
                     decoded_sha256=hashlib.sha256(decoded.tobytes()).hexdigest())
            report['cases'].append(row)
            save()
            print(f'{name} {label}: {sum(c["passed"] for c in checks.values())}/{len(checks)} checks, {len(packet)} bytes',flush=True)
    baseline={row['case']:row for row in report['cases'] if row['codec']=='png'}
    baseline_bytes=sum(row['packet_bytes'] for row in baseline.values())
    for label in ('png','jpeg-85','jpeg-95','jpeg-100'):
        rows=[row for row in report['cases'] if row['codec']==label]
        regressions=[];text_changes=[]
        for row in rows:
            original=baseline[row['case']]
            regressions += [dict(case=row['case'],field=field,actual=check['actual'],expected=check['expected'])
                for field,check in row['checks'].items()
                if original['checks'][field]['passed'] and not check['passed']]
            text_changes += [dict(case=row['case'],field=field,png=original['text'][field],candidate=value)
                for field,value in row['text'].items() if value!=original['text'][field]]
        report['summary'][label]=dict(cases=len(rows),
            labeled_checks_passed=sum(check['passed'] for row in rows for check in row['checks'].values()),
            labeled_checks_total=sum(len(row['checks']) for row in rows),
            packet_bytes=sum(row['packet_bytes'] for row in rows),
            byte_reduction_percent=100*(1-sum(row['packet_bytes'] for row in rows)/baseline_bytes),
            median_encode_ms=float(np.median([row['encode_ms'] for row in rows])),
            median_receive_ms=float(np.median([row['receive_ms'] for row in rows])),
            median_ocr_seconds=float(np.median([row['ocr_seconds'] for row in rows])),
            card_regressions=regressions,text_changes=text_changes,
            eligible_on_this_corpus=not regressions and not text_changes)
    report['status']='completed'
    save()
    print(json.dumps(report['summary'],ensure_ascii=False,indent=2))
    return 0 if all(s['eligible_on_this_corpus'] for s in report['summary'].values()) else 1


if __name__=='__main__':
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output',type=Path,required=True)
    parser.add_argument('--repeats',type=int,default=7)
    args=parser.parse_args()
    if not 1<=args.repeats<=100: parser.error('Use 1 a 100 repetições')
