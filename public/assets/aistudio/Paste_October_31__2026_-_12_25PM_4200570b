The collector must discover and capture this window normally. No frame is injected
into the collector or the Central. The control file is used only by this fixture.
"""
import argparse
import json
from pathlib import Path
import tkinter as tk

from PIL import Image, ImageTk
from visualpilot.pppoker.capture import enable_dpi_awareness


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--control', type=Path, required=True)
    parser.add_argument('--state', type=Path, required=True)
    args = parser.parse_args()
    enable_dpi_awareness()
    window = tk.Tk()
    window.title('Recorded laboratory table')
    window.overrideredirect(True)
    window.configure(background='#202020')
    window.geometry(f'{window.winfo_screenwidth()}x{window.winfo_screenheight()}+0+0')
    labels = []
    previous = None

    def update():
        nonlocal previous
        command = json.loads(args.control.read_text(encoding='utf-8'))
        if command != previous:
            for label in labels:
                label.destroy()
            labels.clear()
            sources = command.get('images') or ([command['image']] if command.get('image') else [])
            boxes = []
            available = window.winfo_screenwidth()-580
            max_width = min(835, available//max(1, len(sources))-20)
            if sources and max_width < 240:
                raise RuntimeError('Desktop muito pequeno para as mesas e o diagnóstico do Coletor.')
            for index, source in enumerate(sources):
                with Image.open(source) as original:
                    picture = original.convert('RGB')
                picture.thumbnail((max_width, window.winfo_screenheight()-80), Image.Resampling.LANCZOS)
                width, height = picture.size
                label = tk.Label(window, borderwidth=0, highlightthickness=0, background='#202020')
                label.photo = ImageTk.PhotoImage(picture)
                label.configure(image=label.photo)
                left = 20 + index*(max_width+20)
                top = 20 + command.get('offset_y', 0)
                label.place(x=left, y=top, width=width, height=height)
                boxes.append([left, top, width, height])
                labels.append(label)
            window.update_idletasks()
            args.state.write_text(json.dumps(dict(command, boxes=boxes,
                screen=[window.winfo_screenwidth(), window.winfo_screenheight()])), encoding='utf-8')
            previous = command
        window.after(100, update)

    update()
    window.mainloop()


if __name__ == '__main__':
    main()


