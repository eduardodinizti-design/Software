from __future__ import annotations

import argparse
import json
import statistics
import threading
import time
from pathlib import Path
from queue import Empty, Queue

from PIL import Image, ImageTk
import tkinter as tk

from visualpilot.pppoker.observer.runtime import PerceptionSession


ROOT = Path(__file__).resolve().parents[1]
SOURCES = [ROOT / "tests/fixtures/actions/left_99.png",
           ROOT / "tests/fixtures/actions/right_99.png"]
EXPECTED = [
    {
        "hero": ["Th", "4d"],
        "board": ["7h", "As", "Ts"],
        "street": "flop",
        "hand_id": "261023232509-13536175-0000157-5",
        "hero_buttons": [],
        "visible_actions": {("vitriago", "check"), ("rossykind4", "fold"),
                            ("SDekus", "fold"), ("KKingJJam..", "fold")},
    },
